<style>
  .swatch {
    border-radius: 100%;
    width: 30px;
    height: 30px;
    display: block !important;
    background-color: {{ backgroundcolor }};
  }
</style>

{% comment %}
  This is your Liquid sandbox

  {% comment %} variable assign {%  %} this used for vaiable declare {% endcomment %}
  {% assign practice_variable = "Hello from tutorial.liquid!" %}

  <div style="background-color: #ffd700; padding: 20px; text-align: center; font-weight: bold;">
    {% comment %} variable prints, {{  }} this used for print {% endcomment %}
    {{ practice_variable }}
  </div>

  {%  capture html %}
    <div>
      <p> hello {{ product.title }}</p>
    </div>
  {% endcapture %}

  {{ html }}
{% endcomment %}

{% comment %}
  {% assign num = 11 %}
  {% if num > 10 %}
    <p>num is graterthan 10</p>
  {% else %}
    <p>num is lessthan or equal to 10</p>
  {% endif %}

  {% if product.title contains 'Espresso' %}
    <p>this is Espresso coffee</p>
  {% endif %}

  {% unless product.tags contains 'premium' %}
    <p>this product deasn't contain premuim tag</p>

  {% endunless %}

  {% case product.type %}
    {% when 'coffee' %}
      <p>this is coffee product</p>

    {% else %}
      <p>not a coffee product</p>
  {% endcase %}
{% endcomment %}
{% comment %}
  {% if products.size >= 2 %}
    {% paginate collection.products by 5 %}
      {% for product in collection.products %}
        <p>{{ product.tilte }}</p>
      {% endfor %}

      {{ paginate | default_pagination }}
    {% endpaginate %}
  {% endif %}
  {% assign num = '10' %}
  {% assign sum = num | plus: 5 %}
  {{ sum }}
  <br>
  {% assign sum = num | minus: 5 %}
  {{ sum }}
  <br>
  {% assign sum = num | times: 5 %}
  {{ sum }}
  <br>
  {% assign sum = num | divided_by: 5 %}
  {{ sum }}
{% endcomment %}

{% comment %}
  {% assign products = collection.products %}
  {% assign product_titles = products | map: 'title' %}

  {% for product_title in product_titles %}
    <p>{{ product_title }}</p>
  {% endfor %}

  <p>{{ product_titles | join: ' - ' }}</p>

  {% assign priceSorted = products | sort: 'price' %}
  {% for product in products %}
    <p>{{ product_title }} - {{ product.price | money }}</p>
  {% endfor %}
{% endcomment %}

{% comment %} {% assign backgroundcolor = '#c6222200' %}
<div class="swatch" style="background: {{ backgroundcolor }}"></div> {% endcomment %}
